{
  "manifestVersion": 1,
  "pluginId": "ai.rever.boss.plugin.dynamic.usersecretlist",
  "displayName": "My Secrets (Dynamic)",
  "version": "1.0.6",
  "apiVersion": "1.0.20",
  "minBossVersion": "9.2.20",
  "dependencies": [
    {
      "pluginId": "ai.rever.boss.plugin.dynamic.secretmanager",
      "version": "*",
      "optional": false
    }
  ],
  "mainClass": "ai.rever.boss.plugin.dynamic.usersecretlist.UserSecretListDynamicPlugin",
  "type": "panel",
  "description": "Retired - now the \"Shared with me\" section of Secret Manager",
  "author": "Risa Labs",
  "url": "https://github.com/risa-labs-inc/boss-plugin-user-secret-list",
  "panel": {
    "position": "right_top_bottom",
    "priority": 25
  },
  "sandbox": {
    "maxThreads": 4,
    "maxRestartAttempts": 3,
    "heartbeatIntervalMs": 5000
  },
  "isolationMode": "out-of-process",
  "fallback": "in-process",
  "stateHolderClass": "ai.rever.boss.plugin.runtime.stateholders.SecretManagerStateHolder"
}
